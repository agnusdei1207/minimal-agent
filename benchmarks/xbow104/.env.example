# Prefer copying this example to the PROJECT ROOT as `.env` (gitignored).
# XBOW checks project-root .env first, then this directory's legacy .env.
# Fill in ONE backbone. File values override inherited shell exports.
# NEVER commit the real .env.

# --- Anthropic-compatible backbone ---
# ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
# ANTHROPIC_AUTH_TOKEN=<your-token>
# ANTHROPIC_DEFAULT_HAIKU_MODEL=MiniMax-M3[1m]

# --- OpenAI-compatible backbone ---
# OPENAI_API_KEY=<your-key>
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=minimax/minimax-m3:free
# OPENAI_PROVIDER=openrouter
# OPENAI_MAX_TOKENS=8192
