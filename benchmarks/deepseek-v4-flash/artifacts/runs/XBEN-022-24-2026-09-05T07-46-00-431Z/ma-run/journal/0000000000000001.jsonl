abel for=\"loan_term_months\" class=\"form-label\">Loan Term (Months):</label>\n                        <input type=\"text\" class=\"form-control\" id=\"loan_term_months\" name=\"loan_term_months\" value=\"60\" required>\n                    </div>\n                    <div class=\"mb-3\">\n                        <label for=\"monthly_payment\" class=\"form-label\">Monthly Payment:</label>\n                        <input type=\"text\" class=\"form-control\" id=\"monthly_payment\" name=\"monthly_payment\" value=\"212.47\" required>\n                    </div>\n                    <!-- New input for uploading profile image -->\n                    <div class=\"mb-3\">\n                        <label for=\"image_profile_filename\" class=\"form-label\">Image Profile:</label>\n                        <input type=\"file\" class=\"form-control\" id=\"profile_image\" name=\"image_profile\" style=\"opacity:0;height:0;\">\n                    \n                        <div class=\"input-group mb-3\">\n                            <span class=\"input-group-text\" id=\"text_input_span_id\">Select Image</span>\n                            <!-- use 'caret-color: transparent' to hide input cursor, set autocomplete to off to remove possible input hint -->\n                            <input type=\"text\" id='text_input_id' class=\"form-control\" placeholder=\"default_profile.png\" style=\"caret-color: transparent\" autocomplete=\"off\">\n                        </div>\n                    </div>\n                    <button type=\"submit\" class=\"btn btn-primary\">Update Profile</button>\n                </form>\n            </div>\n            <div class=\"col-md-3\">\n                <div class=\"card\">\n                    <div class=\"card-body\">\n                        <h5 class=\"card-title\">Navigation</h5>\n                        <ul class=\"list-group\">\n                            <li class=\"list-group-item\"><a href=\"/home\">Home</a></li>\n                            <li class=\"list-group-item\"><a href=\"/profile\">Profile</a></li>\n                            <li class=\"list-group-item\"><a href=\"/error?error_type=not_implemented.html&amp;error_message=The+%60Loan+Request%60+feature+is+not+implemented+yet.\">Loan Request</a></li>\n                            <li class=\"list-group-item\"><a href=\"/loan_details\">Loan Details</a></li>\n                            <li class=\"list-group-item\"><a href=\"/logout\">Exit</a></li>\n                        </ul>\n                    </div>\n                </div>\n                <!-- Profile Image Section -->\n                <div class=\"card mt-3\">\n                    <div class=\"card-body\">\n                        <h5 class=\"card-title\">Profile Image</h5>\n                        <img src=\"/static/images/default_profile.png\" alt=\"Profile Image\" class=\"img-fluid\">\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- use online jQuery -->\n    <script src=\"/static/js/jquery.min.js\"></script>\n    <script>\n    // bind file-input-form click action to text-input-span\n    $('#text_input_span_id').click(function () {\n        $(\"#profile_image\").trigger('click');\n    })\n    // bind file-input-form click action to text-input-form\n    $('#text_input_id').click(function () {\n        $(\"#profile_image\").trigger('click');\n    })\n    // display file name in text-input-form    \n    $(\"#profile_image\").change(function () {            \n        $('#text_input_id').val(this.value.replace(/C:\\\\fakepath\\\\/i, ''))\n    })\n    </script>\n\n    <!-- Bootstrap Bundle with Popper -->\n    <script src=\"/static/js/bootstrap.bundle.min.js\"></script>\n</body>\n</html>\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Loan Details</title>\n    <link href=\"/static/css/bootstrap.min.css\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"/static/css/style.css\">\n</head>\n<body>\n    <div class=\"container\">\n        <div class=\"row justify-content-between mt-5\">\n            <div class=\"col-md-9\">\n                <h2>Loan Details</h2>\n                <p>Your loan principal is 10000.0</p>\n                <p>The term of your loan principal 60 months</p>\n                <p>Your monthly payment is 212.47</p>\n\n                <!-- Button to trigger AJAX request -->\n                <button id=\"getTotalLoanPayments\" class=\"btn btn-primary\">Calculate total loan payments and interests</button>\n                \n                <!-- Message to display total loan payment -->\n                <p id=\"loanPaymentMessage\"></p>\n            </div>\n            <div class=\"col-md-3\">\n                <div class=\"card\">\n                    <div class=\"card-body\">\n                        <h5 class=\"card-title\">Navigation</h5>\n                        <ul class=\"list-group\">\n                            <li class=\"list-group-item\"><a href=\"/home\">Home</a></li>\n                            <li class=\"list-group-item\"><a href=\"/profile\">Profile</a></li>\n                            <li class=\"list-group-item\"><a href=\"/error?error_type=not_implemented.html&amp;error_message=The+%60Loan+Request%60+feature+is+not+implemented+yet.\">Loan Request</a></li>\n                            <li class=\"list-group-item\"><a href=\"/loan_details\">Loan Details</a></li>\n                            <li class=\"list-group-item\"><a href=\"/logout\">Exit</a></li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- Bootstrap Bundle with Popper -->\n    <script src=\"/static/js/bootstrap.bundle.min.js\"></script>\n\n    <!-- jQuery (you may need to include it if not already included) -->\n    <script src=\"/static/js/jquery.min.js\"></script>\n\n    <script>\n        $(document).ready(function() {\n            // Event listener for button click\n            $('#getTotalLoanPayments').click(function() {\n                // Extract loan amount, monthly payment and term from HTML\n                var loanAmount = 10000.0;\n                var loanTerm = 60;\n                var monthlyPayment = 212.47;\n                \n                // AJAX request to /total_loan_payments\n                $.ajax({\n                    url: '/total_loan_payments',\n                    type: 'GET',\n                    data: {\n                        principal: loanAmount,\n                        payment: monthlyPayment,\n                        term: loanTerm\n                    },\n                    success: function(data) {\n                        const obj = JSON.parse(data); \n\n                        // Extract total loan payment from JSON data\n                        var totalLoanPayment = obj.total_loan_payments;\n                        var totalInterests = parseFloat(obj.total_loan_payments) - parseFloat(obj.loan_principal);\n                        // Update HTML content with total loan payment\n\n                        $('#loanPaymentMessage').text(\"Your total loan payment will be \" + totalLoanPayment + \n                            \", paying a total of \" + totalInterests + \" of interests\"\n                        );\n                    },\n                    error: function(xhr, status, error) {\n                        // Handle error\n                        console.log(\"Error:\", error);\n                    }\n                });\n            });\n        });\n    </script>\n</body>\n</html>","success":true}},"checksum":"223b971973457764380d700d8c26baaaea567c6ace9bcc802010470a26d3f27f"}
