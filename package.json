{
  "name": "pentesting",
  "version": "0.200.0",
  "description": "A small autonomous team-agent runtime powered by Rust",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agnusdei1207/pentesting.git"
  },
  "homepage": "https://github.com/agnusdei1207/pentesting#readme",
  "bugs": "https://github.com/agnusdei1207/pentesting/issues",
  "type": "module",
  "bin": {
    "pentesting": "bin/pentesting.js",
    "minimal-agent": "bin/pentesting.js"
  },
  "files": [
    "bin/",
    "scripts/bounded-download.mjs",
    "scripts/install.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node scripts/install.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run check:docker",
    "check:docker": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check.ps1",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1",
    "docker:base": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dimage.ps1 -Target base -Push",
    "docker:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dimage.ps1 -Target all -Tag pentesting:check",
    "xbow": "node benchmarks/harness/task.mjs",
    "xbow:run": "node benchmarks/harness/runner.mjs --all --concurrency 1",
    "xbow:setup": "node benchmarks/harness/runner.mjs --setup",
    "xbow:doctor": "node benchmarks/harness/doctor.mjs",
    "xbow:summary": "node benchmarks/harness/summary.mjs",
    "xbow:kpi": "node benchmarks/harness/kpi.mjs",
    "xbow:results": "node benchmarks/harness/build-results-index.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agent",
    "multi-agent",
    "rust",
    "tui"
  ],
  "dependencies": {
    "opencode-ai": "^1.18.27"
  }
}
